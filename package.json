{
  "name": "xuanshu",
  "private": true,
  "version": "1.35.0",
  "type": "module",
  "description": "玄枢录——一款文字修仙放置游戏",
  "author": "Mystvio",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "build:release": "vue-tsc -b && XIAN_LEGACY=1 vite build",
    "check:legacy": "bun scripts/legacy-artifacts.mjs",
    "check:first-paint": "bun scripts/first-paint.mjs",
    "preview": "vite preview",
    "lint": "eslint src packages",
    "test": "vitest run",
    "test:engine": "vitest run packages/engine",
    "test:report": "bun scripts/test-report.mjs",
    "build:engine": "tsc -p packages/engine/tsconfig.build.json",
    "check:engine": "bun scripts/engine-dist.mjs && bun scripts/engine-sync.mjs",
    "check:engine:standalone": "bun scripts/engine-standalone.mjs",
    "sync:engine": "git subtree push --prefix=packages/engine engine main",
    "type-check": "vue-tsc -b",
    "check": "bun run type-check && bun run lint && bun scripts/docs-check.mjs",
    "build:electron": "bun run build:release && esbuild electron/main.js --bundle --platform=node --format=esm --outfile=dist-electron/main.js --external:electron && esbuild electron/preload.js --bundle --platform=node --format=cjs --outfile=dist-electron/preload.js --external:electron && electron-builder",
    "build:android": "bun run build:release && bunx cap sync android",
    "build:apk": "bun run build:android && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/app": "^8.0.1",
    "@capacitor/core": "^8.1.0",
    "@capacitor/filesystem": "^8.1.2",
    "@types/crypto-js": "^4.2.2",
    "crypto-js": "^4.1.1",
    "file-saver": "^2.0.5",
    "pinia": "^3.0.1",
    "pinia-plugin-persistedstate": "^4.2.0",
    "tone": "^15.1.22",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "wanxiang-engine": "workspace:*"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.13.0",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.4",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.0",
    "eslint": "^9.20.0",
    "eslint-plugin-vue": "^9.32.0",
    "playwright": "1.63.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  },
  "browserslist": [
    "Chrome >= 51",
    "Android >= 7",
    "iOS >= 12",
    "Safari >= 12"
  ],
  "build": {
    "appId": "com.mystvio.xuanshu",
    "productName": "玄枢录",
    "asar": false,
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "public/**/*",
      "package.json"
    ],
    "directories": {
      "output": "pkg"
    },
    "win": {
      "target": "zip",
      "icon": "public/favicon.ico",
      "artifactName": "xuanshu-${version}-win.${ext}"
    }
  }
}
