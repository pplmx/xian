{
  "name": "xuanshu",
  "version": "1.35.0",
  "private": true,
  "description": "玄枢录——一款文字修仙放置游戏",
  "license": "MIT",
  "author": "Mystvio",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vp dev --host 0.0.0.0",
    "build": "vue-tsc -b && vp build",
    "check:first-paint": "bun scripts/first-paint.mjs",
    "preview": "vp preview",
    "lint": "vp lint",
    "test": "vp test run",
    "test:engine": "vp test run packages/engine",
    "test:report": "bun scripts/test-report.mjs",
    "build:engine": "tsc -p packages/engine/tsconfig.build.json",
    "check:engine": "bun scripts/engine-dist.mjs && bun scripts/engine-sync.mjs",
    "check:engine:standalone": "bun scripts/engine-standalone.mjs",
    "sync:engine": "git subtree push --prefix=packages/engine engine main",
    "type-check": "vue-tsc -b",
    "check": "bun scripts/env-check.mjs && bun run type-check && bun run lint && bun scripts/docs-check.mjs",
    "build:electron": "bun run build && esbuild electron/main.js --bundle --platform=node --format=esm --outfile=dist-electron/main.js --external:electron && esbuild electron/preload.js --bundle --platform=node --format=cjs --outfile=dist-electron/preload.js --external:electron && electron-builder",
    "build:android": "bun run build && bunx cap sync android",
    "build:apk": "bun run build:android && cd android && ./gradlew assembleRelease",
    "prepare": "vp config --no-agent"
  },
  "dependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/app": "^8.0.1",
    "@capacitor/core": "^8.1.0",
    "@capacitor/filesystem": "^8.1.2",
    "@types/crypto-js": "^4.2.2",
    "crypto-js": "^4.1.1",
    "file-saver": "^2.0.5",
    "pinia": "^3.0.1",
    "pinia-plugin-persistedstate": "^4.2.0",
    "tone": "^15.1.22",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "wanxiang-engine": "workspace:*"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.13.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.4",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.0",
    "playwright": "1.63.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "bun@1.4.2",
  "build": {
    "appId": "com.mystvio.xuanshu",
    "productName": "玄枢录",
    "asar": false,
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "public/**/*",
      "package.json"
    ],
    "directories": {
      "output": "pkg"
    },
    "win": {
      "target": "zip",
      "icon": "public/favicon.ico",
      "artifactName": "xuanshu-${version}-win.${ext}"
    }
  }
}
