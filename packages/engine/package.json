{
  "name": "wanxiang-engine",
  "version": "0.1.22",
  "description": "万象引擎 —— 可配置的数值游戏内核:等级(境界)/属性/装备/副本四套系统 + 账本·任务·掉落·保底·图鉴等横切层。零运行时依赖、纯 ESM,换一套名称与内容就能搭出自己的游戏",
  "keywords": [
    "attributes",
    "deterministic",
    "dungeon",
    "equipment",
    "esm",
    "game-engine",
    "idle",
    "idle-game",
    "level",
    "loot",
    "progression",
    "rpg",
    "simulation",
    "typescript"
  ],
  "homepage": "https://github.com/pplmx/wanxiang-engine#readme",
  "bugs": {
    "url": "https://github.com/pplmx/wanxiang-engine/issues"
  },
  "license": "MIT",
  "author": "Mystvio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pplmx/wanxiang-engine.git"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./presets/xiuxian": {
      "types": "./dist/presets/xiuxian.d.ts",
      "import": "./dist/presets/xiuxian.js"
    },
    "./presets/demo": {
      "types": "./dist/presets/demo.d.ts",
      "import": "./dist/presets/demo.js"
    },
    "./presets/daily": {
      "types": "./dist/presets/daily.d.ts",
      "import": "./dist/presets/daily.js"
    },
    "./presets/minimal": {
      "types": "./dist/presets/minimal.d.ts",
      "import": "./dist/presets/minimal.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vp test run",
    "tuning": "vp test run --reporter=verbose src/*.sim.spec.ts",
    "test:watch": "vp test",
    "examples": "bun examples/from-zero.ts && bun examples/quickstart.ts && bun examples/minimal.ts && bun examples/combo-arts.ts && bun examples/daily-loop.ts && bun examples/quest-loop.ts && bun examples/collect-loop.ts && bun examples/shop-loop.ts && bun examples/world-loop.ts && bun examples/craft-loop.ts && bun examples/realm-ladder.ts && bun examples/combat-takeover.ts && bun examples/arena-takeover.ts && bun examples/error-codes.ts",
    "type-check:examples": "tsc -p tsconfig.examples.json",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify:package": "publint && attw --pack . --profile esm-only",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.examples.json && vp test run && tsc -p tsconfig.build.json && node scripts/verify-dist.mjs && bun run verify:package && bun run examples"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.0.0",
    "publint": "^0.3.25",
    "typescript": "~6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26"
  }
}
