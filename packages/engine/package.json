{
  "name": "wanxiang-engine",
  "version": "0.1.0",
  "description": "万象引擎 —— 可配置的等级(境界)/装备/属性/副本系统内核:换一套名称与内容,就能搭出自己的游戏",
  "type": "module",
  "license": "CC-BY-NC-4.0",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./presets/xiuxian": {
      "types": "./dist/presets/xiuxian.d.ts",
      "import": "./dist/presets/xiuxian.js"
    },
    "./presets/demo": {
      "types": "./dist/presets/demo.d.ts",
      "import": "./dist/presets/demo.js"
    },
    "./presets/daily": {
      "types": "./dist/presets/daily.d.ts",
      "import": "./dist/presets/daily.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:dist": "node scripts/verify-dist.mjs",
    "check": "tsc -p tsconfig.json --noEmit && vitest run && tsc -p tsconfig.build.json && node scripts/verify-dist.mjs"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "keywords": [
    "game-engine",
    "idle-game",
    "rpg",
    "level",
    "equipment",
    "attributes",
    "dungeon"
  ]
}
